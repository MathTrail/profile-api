{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Profile service for the MathTrail ecosystem. Manages user profiles, skills, and progress.",
        "title": "MathTrail Profile Service API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/api/v1",
    "paths": {
        "/health": {
            "get": {
                "description": "Returns service health status",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "Service is healthy",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/profile/{userId}": {
            "get": {
                "description": "Retrieve complete user profile including skills and progress by user ID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "profiles"
                ],
                "summary": "Get user profile",
                "parameters": [
                    {
                        "type": "string",
                        "description": "User ID from Kratos",
                        "name": "userId",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Profile retrieved successfully",
                        "schema": {
                            "$ref": "#/definitions/internal_profile.Profile"
                        }
                    },
                    "400": {
                        "description": "Invalid user ID",
                        "schema": {
                            "$ref": "#/definitions/internal_profile.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Profile not found",
                        "schema": {
                            "$ref": "#/definitions/internal_profile.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal server error",
                        "schema": {
                            "$ref": "#/definitions/internal_profile.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "internal_profile.ErrorResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "PROFILE_NOT_FOUND"
                },
                "details": {
                    "type": "string",
                    "example": "profile not found: kratos-user-123"
                },
                "message": {
                    "type": "string",
                    "example": "profile not found"
                }
            }
        },
        "internal_profile.Profile": {
            "type": "object",
            "properties": {
                "age": {
                    "type": "integer"
                },
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "progress": {
                    "$ref": "#/definitions/internal_profile.Progress"
                },
                "skills": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/internal_profile.Skill"
                    }
                },
                "updated_at": {
                    "type": "string"
                },
                "user_id": {
                    "type": "string"
                }
            }
        },
        "internal_profile.Progress": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "current_streak": {
                    "type": "integer"
                },
                "id": {
                    "type": "string"
                },
                "profile_id": {
                    "type": "string"
                },
                "tasks_completed": {
                    "type": "integer"
                },
                "total_points": {
                    "type": "integer"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "internal_profile.Skill": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "level": {
                    "type": "integer"
                },
                "proficiency": {
                    "type": "number"
                },
                "profile_id": {
                    "type": "string"
                },
                "skill_name": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        }
    }
}